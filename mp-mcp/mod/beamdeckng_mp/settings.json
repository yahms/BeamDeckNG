{
  "_readme": "What players' BeamDeckNG Stream Decks may do on this server. Remove a name to block it, add one to allow it. A list left out uses the built-in defaults. See the BeamDeckNG MP-MCP README for every name. menus: game menu pages a key may open when what it does directly isn't allowed. controls: the vehicle's own controls (tray, hydraulics, fifth wheel...) by name pattern; * matches anything, ! blocks, the last match decides.",
  "vehicle": [
    "engine", "traction", "drive_mode_step", "diff_lock", "diff_combo", "center_diff", "range", "drive",
    "parking_brake", "lights", "fog", "hazard", "signal", "lightbar", "lightbar_mode", "horn", "cruise", "engine_brake",
    "retarder", "air_suspension", "body", "pt_click", "tire_pressure"
  ],
  "actions": [
    "menu_item_select", "menu_item_back", "menu_item_up", "menu_item_down", "menu_item_left", "menu_item_right",
    "toggleBigMap", "toggleRadialMenuMulti", "photomode", "couplersToggle", "center_camera", "look_back",
    "rotate_camera_left", "rotate_camera_right", "unicycle__walkUp", "unicycle__walkDown", "unicycle__walkLeft",
    "unicycle__walkRight", "unicycle__sprintHold",
    "moveup", "movedown", "increase_zoom", "decrease_zoom"
  ],
  "game": ["set_camera", "cam_step", "cam_driver", "toggle_ui", "walk"],
  "menus": ["environment", "weather", "simulation", "traffic", "vehicle_config", "vehicle_selector", "multiplayer"],
  "controls": ["*", "!jato*", "!*nitrous*", "!*n2o*"]
}
