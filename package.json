{
  "name": "beamdeckng",
  "version": "0.2.4",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.yahms.beamdeckng\"",
    "pack": "streamdeck pack com.yahms.beamdeckng.sdPlugin -o dist -f",
    "pack:mp": "node beammp-addon/pack.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@material-symbols/svg-400": "^0.49.0",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node20": "^20.1.11",
    "@types/node": "^22.20.5",
    "rollup": "^4.68.3",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "private": true
}
